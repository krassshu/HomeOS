# HomeIntelCore — lokalna konfiguracja developerska.
# Skopiuj przez `pnpm dev:setup` (generuje losowe hasło); nie wpisuj tego pliku
# jako prawdziwego .env i nie commituj wygenerowanego .env.

# Core PostgreSQL 18 (infra/dev/compose.yaml). Port jest publikowany tylko na 127.0.0.1.
HOMEINTELCORE_DB_USER=homeintelcore
HOMEINTELCORE_DB_NAME=homeintelcore
HOMEINTELCORE_DB_PORT=55432
HOMEINTELCORE_DB_PASSWORD=__GENERATED_BY_DEV_SETUP__

# Core API. DATABASE_URL musi zawierać to samo hasło co HOMEINTELCORE_DB_PASSWORD;
# dev:setup podmienia tylko hasło, więc zmianę użytkownika, portu lub nazwy bazy wpisz w obu miejscach.
DATABASE_URL=postgresql://homeintelcore:__GENERATED_BY_DEV_SETUP__@127.0.0.1:55432/homeintelcore
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
READINESS_TIMEOUT_MS=2000
SHUTDOWN_TIMEOUT_MS=10000
