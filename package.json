{
  "name": "homeintelcore",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": "11.18.0"
  },
  "scripts": {
    "build": "pnpm --recursive --if-present build",
    "check": "pnpm prisma:generate && pnpm docs:check && pnpm check:deps && pnpm check:tracked && pnpm check:compose && pnpm lint && pnpm typecheck && pnpm build && pnpm test && pnpm format:check",
    "check:compose": "node scripts/check-compose.mjs",
    "check:deps": "node scripts/check-dependencies.mjs",
    "check:secrets": "sh scripts/check-secrets.sh",
    "check:tracked": "node scripts/check-tracked-files.mjs",
    "db:config": "docker compose --env-file .env -f infra/dev/compose.yaml config --quiet",
    "db:down": "docker compose --env-file .env -f infra/dev/compose.yaml down",
    "db:logs": "docker compose --env-file .env -f infra/dev/compose.yaml logs --tail 100 core-db",
    "db:ps": "docker compose --env-file .env -f infra/dev/compose.yaml ps",
    "db:reset": "node scripts/db-reset.mjs",
    "db:sql": "docker compose --env-file .env -f infra/dev/compose.yaml exec core-db sh -c 'psql -U \"$POSTGRES_USER\" -d \"$POSTGRES_DB\" -c \"SELECT version()\" -c \"SELECT uuid_extract_version(uuidv7()) AS uuidv7_version\"'",
    "db:stop": "docker compose --env-file .env -f infra/dev/compose.yaml stop",
    "db:up": "docker compose --env-file .env -f infra/dev/compose.yaml up -d --wait",
    "dev": "node scripts/with-env.mjs pnpm --filter @homeintelcore/api dev",
    "dev:setup": "node scripts/dev-setup.mjs",
    "docker:build": "docker build -f apps/api/Dockerfile -t homeintelcore-api:dev .",
    "docs:check": "node scripts/validate-docs.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "pnpm --recursive --if-present lint",
    "prisma:generate": "pnpm --filter @homeintelcore/api prisma:generate",
    "prisma:validate": "pnpm --filter @homeintelcore/api prisma:validate",
    "sbom:generate": "pnpm sbom --sbom-format cyclonedx --sbom-type application --sbom-supplier HomeIntelCore --out sbom/homeintelcore.cdx.json",
    "start": "node scripts/with-env.mjs pnpm --filter @homeintelcore/api start",
    "test": "pnpm --recursive --if-present test",
    "test:integration": "pnpm --recursive --if-present test:integration",
    "test:unit": "pnpm --recursive --if-present test:unit",
    "typecheck": "pnpm --recursive --if-present typecheck"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.6",
    "typescript-eslint": "8.65.0"
  }
}
