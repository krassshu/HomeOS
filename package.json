{
  "name": "homeos",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": "11.18.0"
  },
  "scripts": {
    "build": "pnpm --recursive --if-present build",
    "check": "pnpm docs:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm format:check",
    "dev": "pnpm --filter @homeos/api dev",
    "docs:check": "node scripts/validate-docs.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "pnpm --recursive --if-present lint",
    "test": "pnpm --recursive --if-present test",
    "typecheck": "pnpm --recursive --if-present typecheck"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.6",
    "typescript-eslint": "8.65.0"
  }
}
