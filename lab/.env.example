# Skopiuj jako .env.source i zastąp każdą wartość replace-this.
PAPERLESS_DB_PASSWORD=replace-this-source-paperless-db-password
PAPERLESS_SECRET_KEY=replace-this-source-paperless-secret-key
CORE_FIXTURE_DB_PASSWORD=replace-this-source-core-db-password

PAPERLESS_UI_PORT=8000
VALKEY_SHARED_PORT=16379
VALKEY_CORE_PORT=16380

PAPERLESS_TIME_ZONE=UTC
PAPERLESS_OCR_LANGUAGE=pol
PAPERLESS_OCR_LANGUAGES=pol
PAPERLESS_CONSUMER_DELETE_DUPLICATES=false
