{
  "name": "homeos-e2-orm-poc",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.18.0"
  },
  "scripts": {
    "generate:prisma": "prisma generate --config prisma.config.ts",
    "migrate:drizzle": "tsx drizzle/migrate.ts",
    "migrate:prisma": "prisma migrate deploy --config prisma.config.ts",
    "run:drizzle": "tsx shared/run.ts drizzle",
    "run:prisma": "tsx shared/run.ts prisma",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "drizzle-orm": "0.45.2",
    "pg": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/pg": "8.20.0",
    "drizzle-kit": "0.31.10",
    "prisma": "7.9.1",
    "tsx": "4.23.1",
    "typescript": "5.9.3"
  }
}
