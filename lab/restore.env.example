# Skopiuj jako .env.restore i zastąp każdą wartość replace-this.
PAPERLESS_DB_PASSWORD=replace-this-restore-paperless-db-password
PAPERLESS_SECRET_KEY=replace-this-restore-paperless-secret-key
CORE_FIXTURE_DB_PASSWORD=replace-this-restore-core-db-password

PAPERLESS_UI_PORT=8100
VALKEY_SHARED_PORT=26379
VALKEY_CORE_PORT=26380

PAPERLESS_TIME_ZONE=UTC
PAPERLESS_OCR_LANGUAGE=pol
PAPERLESS_OCR_LANGUAGES=pol
PAPERLESS_CONSUMER_DELETE_DUPLICATES=false
